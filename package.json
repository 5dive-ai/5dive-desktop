{
  "name": "5dive",
  "productName": "5dive",
  "version": "0.4.0",
  "description": "5dive for Mac and Windows: your AI team in its own window, with a menu-bar or tray icon that lights up when an agent needs you.",
  "homepage": "https://github.com/5dive-ai/5dive-desktop",
  "license": "MIT",
  "author": "5dive",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --mac dmg --universal --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.11.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ai.5dive.mac",
    "productName": "5dive",
    "copyright": "Copyright © 2026 5dive",
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "afterPack": "build/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "12.0",
      "artifactName": "5dive-mac.${ext}"
    },
    "dmg": {
      "artifactName": "5dive.dmg",
      "title": "5dive ${version}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "5dive-setup.${ext}",
      "shortcutName": "5dive",
      "uninstallDisplayName": "5dive"
    }
  }
}
